<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
We use this file or Maven execution command to manage Parallel/Linear Test
Set parallel to "none" for linear | parallel to "classes" for parallel
Thread count depending on how many Threads to allocate for parallel
-->

<suite name="Steam_Suite" parallel="none" thread-count="8">
    <test name ="Steam_Navigation" preserve-order="true">
        <classes>
            <class name="StorePageTest"/>
            <class name="SearchResultTest"/>
            <class name="GamePageTest"/>
            <class name="DevPageTest"/>
            <class name="PublisherPageTest"/>
            <class name="GameInfoTest"/>
            <class name="ReviewTest"/>
            <class name="CartPageTest"/>
        </classes>
    </test>
</suite>